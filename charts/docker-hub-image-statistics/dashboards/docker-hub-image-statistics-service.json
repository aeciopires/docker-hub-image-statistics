    {
      "type": "timeseries",
      "title": "Collection duration",
      "description": "One collection runs per collector.interval (default 1h).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
