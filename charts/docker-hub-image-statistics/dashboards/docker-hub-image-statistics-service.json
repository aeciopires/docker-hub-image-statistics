          "expr": "max(dhis_last_collection_duration_seconds{job=~\"$job\"})",
          "legendFormat": "last collection",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(dhis_collection_duration_seconds_bucket{job=~\"$job\"}[6h])))",
          "legendFormat": "p95 (6h)",
          "refId": "B"
