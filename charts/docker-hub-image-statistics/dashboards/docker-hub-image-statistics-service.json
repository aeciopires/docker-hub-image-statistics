{
  "uid": "dhis-service",
  "title": "Docker Hub Image Statistics \u2014 Service",
  "description": "Health, metrics, traces and logs of the docker-hub-image-statistics service.",
  "tags": [
    "docker-hub-image-statistics",
    "observability"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(dhis_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(dhis_build_info, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0
      },
      {
        "name": "search",
        "label": "Log filter (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Docker Hub Image Statistics",
      "type": "dashboards",
      "tags": [
        "docker-hub-image-statistics"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Jaeger UI",
      "type": "link",
      "url": "http://localhost:16686/search?service=docker-hub-image-statistics",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Traces in Jaeger (local compose stack)"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Health",
